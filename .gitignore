# Cache and temporary files
.seen_cache.json

# Secrets — never commit (.env.* catches backups like .env.bak-YYYY-MM-DD,
# which hold the same live credentials and once nearly reached `git add -A`)
.env
.env.*
!.env.example

# Email credentials (if stored separately) — root-level only;
# src/briefing/config.py is code (env reads, no secrets) and IS tracked
/config.py
credentials.json

# Runtime logs and debug output
briefing.log
briefing_error.log
debug_*.txt
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv/

# Local database + runtime state (per-machine, not synced)
data/
archive/test-runs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local agent state
.omc/

# PMF index (disposable, rebuildable from ψ/memory/ via `pmf rebuild`)
.pmf/

# OS
.DS_Store
Thumbs.db

# Archives (optional - uncomment if you don't want to track briefing history)
# archives/
.team/
