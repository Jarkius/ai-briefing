# Copy to .env and fill in real values. NEVER commit .env.

# Google Gemini direct API (fallback #1) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
# "gemini-3.5-flash" does not exist as a real model — verified via the API's
# own models list. gemini-flash-latest tracks Google's current stable flash
# release; each model has a separate free-tier daily quota.
GEMINI_MODEL=gemini-flash-latest

# maxplus API key (fallback #2) — https://maxplus-ai.cc
# Model must be one currently served by your maxplus pool — check via a
# deliberately invalid model name, the 400 response lists valid options.
MAXPLUS_API_KEY=ccsk-your-api-key-here
MAXPLUS_MODEL=gpt-5.5

# Safety-net provider tier (fallback #3): shells out to the `claude` CLI
# using your existing Claude subscription (no separate API quota) when both
# API tiers above fail. Set to 0/false to disable.
CLAUDE_CLI_ENABLED=1
CLAUDE_CLI_MODEL=sonnet

# Gmail account used to send the briefing
GMAIL_ADDRESS=you@gmail.com
# Gmail App Password (Google Account → Security → App Passwords)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where the briefing is delivered (defaults to GMAIL_ADDRESS if unset)
RECIPIENT_EMAIL=you@gmail.com

# Gmail API fallback (HTTPS/443) — used automatically if SMTP/IMAP (ports
# 465/587/993) are blocked on the current network. No .env values needed:
# run scripts/setup_gmail_oauth.py once (one-time browser consent) and it
# stores a token at data/gmail_oauth_token.json. See README's
# "Gmail API fallback" section.
#
# Set to 1 once Cloud Console's OAuth consent screen → Audience tab shows
# "In production" (not "Testing") — removes the panel's false "expiring in
# Nd" warning, since Google's 7-day Testing-mode refresh-token limit no
# longer applies. No API/gcloud way to check this automatically; set by hand.
GMAIL_OAUTH_PUBLISHED=0
