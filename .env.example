# Copy to .env and fill in real values. NEVER commit .env.
# maxplus API key (Gemini access) — https://maxplus-ai.cc
MAXPLUS_API_KEY=ccsk-your-api-key-here
# Gmail account used to send the briefing
GMAIL_ADDRESS=you@gmail.com
# Gmail App Password (Google Account → Security → App Passwords)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where the briefing is delivered (defaults to GMAIL_ADDRESS if unset)
RECIPIENT_EMAIL=you@gmail.com
